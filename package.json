    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "better-sqlite3": "12.11.1",
    "dotenv": "16.6.1",
    "fastify": "5.12.7",
    "framer-motion": "12.43.0",
    "grammy": "1.46.0",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
